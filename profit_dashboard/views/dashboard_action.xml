<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Profit Dashboard Client Action
         Registers the OWL dashboard as a client action
         ================================================================ -->

    <record id="action_profit_dashboard" model="ir.actions.client">
        <field name="name">Profit Dashboard / لوحة الربحية</field>
        <field name="tag">profit_dashboard</field>
        <field name="context">{}</field>
        <field name="target">main</field>
        <field name="groups_id" eval="[
            (4, ref('electrical_store_base.group_electrical_storekeeper')),
            (4, ref('electrical_store_base.group_electrical_accountant')),
            (4, ref('electrical_store_base.group_electrical_manager')),
        ]"/>
    </record>

</odoo>
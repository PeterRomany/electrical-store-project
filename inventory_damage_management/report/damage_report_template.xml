<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_damage_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="scrap">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl">

                        <!-- ================================================
                             Report Header
                             ================================================ -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <h2 style="color:#dc3545;">
                                    <i class="fa fa-trash me-2"/>
                                    Damage / Scrap Report
                                </h2>
                                <h4 style="color:#6c757d;">
                                    تقرير الإتلاف والتلف
                                </h4>
                            </div>
                            <div class="col-4 text-start">
                                <table class="table table-sm table-borderless"
                                       style="font-size:12px;">
                                    <tr>
                                        <td><strong>Date / التاريخ:</strong></td>
                                        <td>
                                            <span t-esc="
                                                context_timestamp(
                                                    datetime.datetime.now()
                                                ).strftime('%Y-%m-%d')
                                            "/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reference / المرجع:</strong></td>
                                        <td>
                                            <span t-field="scrap.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Status / الحالة:</strong></td>
                                        <td>
                                            <span t-field="scrap.state"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================================================
                             Scrap Details
                             ================================================ -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <h5 style="
                                    border-bottom:2px solid #dc3545;
                                    padding-bottom:6px;
                                    color:#dc3545;
                                ">
                                    Scrap Details / تفاصيل الإتلاف
                                </h5>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-bordered"
                                       style="font-size:13px;">
                                    <tr class="table-light">
                                        <th colspan="2">
                                            Product Info / معلومات المنتج
                                        </th>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600; width:40%;">
                                            Product / المنتج
                                        </td>
                                        <td>
                                            <span t-field="scrap.product_id"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Lot / Serial
                                        </td>
                                        <td>
                                            <span t-field="scrap.lot_id"
                                                  t-if="scrap.lot_id"/>
                                            <span t-else="">—</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Qty / الكمية
                                        </td>
                                        <td>
                                            <span t-field="scrap.scrap_qty"/>
                                            <span t-field="scrap.product_uom_id"
                                                  style="margin-right:4px;"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Unit Cost / التكلفة
                                        </td>
                                        <td>
                                            <span t-esc="
                                                '%.2f' % (scrap.product_id.standard_price or 0)
                                            "/>
                                            <span style="margin-right:4px;">ج.م</span>
                                        </td>
                                    </tr>
                                    <tr class="table-danger">
                                        <td style="font-weight:700;">
                                            Damage Value / قيمة التلف
                                        </td>
                                        <td style="font-weight:700; color:#dc3545;">
                                            <span t-esc="
                                                '%.2f' % (scrap.damage_value or 0)
                                            "/>
                                            <span style="margin-right:4px;">ج.م</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-6">
                                <table class="table table-sm table-bordered"
                                       style="font-size:13px;">
                                    <tr class="table-light">
                                        <th colspan="2">
                                            Damage Info / معلومات التلف
                                        </th>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600; width:40%;">
                                            Reason / السبب
                                        </td>
                                        <td>
                                            <t t-if="scrap.damage_reason_id">
                                                <span style="
                                                    background:#f8d7da;
                                                    color:#58151c;
                                                    padding:2px 8px;
                                                    border-radius:4px;
                                                    font-weight:600;
                                                ">
                                                    [<t t-esc="scrap.damage_reason_id.code or ''"/>]
                                                    <t t-esc="
                                                        scrap.damage_reason_id.name_arabic
                                                        or scrap.damage_reason_id.name
                                                        or ''
                                                    "/>
                                                </span>
                                            </t>
                                            <span t-else="">غير محدد</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Reported By / بواسطة
                                        </td>
                                        <td>
                                            <span t-field="scrap.reported_by_id"
                                                  t-if="scrap.reported_by_id"/>
                                            <span t-else="">—</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Date / التاريخ
                                        </td>
                                        <td>
                                            <span t-field="scrap.date_done"
                                                  t-if="scrap.date_done"/>
                                            <span t-else="">—</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Source / المصدر
                                        </td>
                                        <td>
                                            <span t-field="scrap.location_id"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">
                                            Scrap Location
                                        </td>
                                        <td>
                                            <span t-field="scrap.scrap_location_id"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================================================
                             Damage Notes
                             ================================================ -->
                        <t t-if="scrap.damage_notes">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 style="color:#495057; font-weight:700;">
                                        Damage Notes / ملاحظات التلف:
                                    </h6>
                                    <div style="
                                        padding:12px;
                                        background:#fff3cd;
                                        border:1px solid #ffda6a;
                                        border-radius:6px;
                                        font-size:13px;
                                        direction:rtl;
                                    ">
                                        <span t-field="scrap.damage_notes"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- ================================================
                             Product Electrical Info
                             ================================================ -->
                        <t t-if="scrap.product_id.brand_id
                                 or scrap.product_id.watt
                                 or scrap.product_id.voltage">
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h6 style="color:#495057; font-weight:700;">
                                        Product Specifications / مواصفات المنتج:
                                    </h6>
                                    <table class="table table-sm table-bordered"
                                           style="font-size:12px;">
                                        <tr>
                                            <t t-if="scrap.product_id.brand_id">
                                                <td><strong>Brand / الماركة</strong></td>
                                                <td>
                                                    <span t-field="scrap.product_id.brand_id"/>
                                                </td>
                                            </t>
                                            <t t-if="scrap.product_id.watt">
                                                <td><strong>Watt / الواط</strong></td>
                                                <td>
                                                    <span t-field="scrap.product_id.watt"/>W
                                                </td>
                                            </t>
                                            <t t-if="scrap.product_id.voltage">
                                                <td><strong>Voltage / الجهد</strong></td>
                                                <td>
                                                    <span t-field="scrap.product_id.voltage"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- ================================================
                             Signature Section
                             ================================================ -->
                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <div style="
                                    border-top:1px solid #000;
                                    padding-top:6px;
                                    margin-top:40px;
                                    font-size:12px;
                                ">
                                    Reported By / بواسطة
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="
                                    border-top:1px solid #000;
                                    padding-top:6px;
                                    margin-top:40px;
                                    font-size:12px;
                                ">
                                    Store Keeper / أمين المخزن
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="
                                    border-top:1px solid #000;
                                    padding-top:6px;
                                    margin-top:40px;
                                    font-size:12px;
                                ">
                                    Manager / المدير
                                </div>
                            </div>
                        </div>

                        <!-- ================================================
                             Footer Note
                             ================================================ -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <p style="
                                    font-size:10px;
                                    color:#6c757d;
                                    text-align:center;
                                    border-top:1px solid #dee2e6;
                                    padding-top:8px;
                                ">
                                    This report was generated automatically by the
                                    Electrical Store ERP System. /
                                    تم إنشاء هذا التقرير تلقائيًا بواسطة نظام إدارة محل الكهرباء.
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Extend Sale Order Form — Add Credit Status Display
         ================================================================ -->

    <record id="view_sale_order_form_credit" model="ir.ui.view">
        <field name="name">sale.order.form.credit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <!-- Credit Status Banners — shown below partner field -->
            <field name="partner_id" position="after">

                <!-- Blocked Banner -->
                <div class="alert alert-danger mb-1 py-2 px-3"
                    role="alert"
                    style="direction:rtl;"
                    invisible="partner_credit_status != 'blocked' or not partner_id">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span> 🚫 <strong>العميل محظور — Credit Blocked</strong> — تجاوز الحد
                            الائتماني المسموح به. يلزم موافقة المدير لتأكيد هذا الطلب. </span>
                        <button name="action_open_credit_override"
                            type="object"
                            string="طلب تجاوز المدير"
                            class="btn btn-sm btn-danger"
                            groups="electrical_store_base.group_electrical_manager"
                            invisible="state not in ['draft', 'sent']" />
                    </div>
                </div>

                <!-- Warning Banner -->
                <div class="alert alert-warning mb-1 py-2 px-3"
                    role="alert"
                    style="direction:rtl;"
                    invisible="partner_credit_status != 'warning' or not partner_id">
                    ⚠️ <strong>تحذير ائتماني — Credit Warning</strong> — العميل اقترب من الحد
                    الائتماني. </div>

                <!-- Hidden fields for attrs logic -->
                <field name="partner_credit_status" invisible="1" />

            </field>

            <!-- Credit Override Info — shown in chatter area if override exists -->
            <xpath expr="(//field[@name='partner_id'])[1]" position="after">
                <field name="credit_override_reason" invisible="1"/>
                <field name="credit_override_user_id"
                    readonly="1"
                    invisible="not credit_override_user_id"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager" />
            </xpath>

            <!-- Add Credit Summary to Other Info tab -->
            <page name="other_information" position="inside">
                <separator string="Credit Info / معلومات الائتمان"
                    invisible="not partner_id"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager" />

                <group
                    invisible="not partner_id"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager">

                    <group string="Customer Credit / ائتمان العميل">
                        <field name="partner_credit_status"
                            readonly="1"
                            string="Status / الحالة"
                            decoration-danger="partner_credit_status == 'blocked'"
                            decoration-warning="partner_credit_status == 'warning'"
                            decoration-success="partner_credit_status == 'ok'" />
                        <field name="partner_credit_limit"
                            readonly="1"
                            string="Limit / الحد"
                            widget="monetary" />
                        <field name="partner_credit_used"
                            readonly="1"
                            string="Used / المستخدم"
                            widget="monetary" />
                        <field name="partner_credit_available"
                            readonly="1"
                            string="Available / المتاح"
                            widget="monetary" />
                    </group>

                    <group string="Override Info / معلومات التجاوز"
                        invisible="not credit_override_reason">
                        <field name="credit_override_reason"
                            readonly="1"
                            string="Override Reason / سبب التجاوز" />
                        <field name="credit_override_user_id"
                            readonly="1"
                            string="Overridden By / بواسطة" />
                    </group>

                </group>

            </page>

        </field>
    </record>

    <!-- ================================================================
         Extend Sale Order List — Add Credit Status Column
         ================================================================ -->

    <record id="view_sale_order_list_credit" model="ir.ui.view">
        <field name="name">sale.order.list.credit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="partner_credit_status"
                    string="Credit / الائتمان"
                    optional="show"
                    decoration-danger="partner_credit_status == 'blocked'"
                    decoration-warning="partner_credit_status == 'warning'"
                    decoration-success="partner_credit_status == 'ok'"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager" />
            </field>

        </field>
    </record>

    <!-- ================================================================
         Extend Sale Order Search — Add Credit Status Filters
         ================================================================ -->

    <record id="view_sale_order_search_credit" model="ir.ui.view">
        <field name="name">sale.order.search.credit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">

            <filter name="my_sale_orders_filter" position="after">
                <separator />
                <filter name="filter_credit_blocked"
                    string="Credit Blocked Orders / طلبات محظورة"
                    domain="[('partner_credit_status', '=', 'blocked')]"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager" />
                <filter name="filter_credit_warning"
                    string="Credit Warning Orders / طلبات تحذير"
                    domain="[('partner_credit_status', '=', 'warning')]"
                    groups="electrical_store_base.group_electrical_accountant,electrical_store_base.group_electrical_manager" />
                <filter name="filter_credit_override"
                    string="Credit Overridden / تم التجاوز"
                    domain="[('credit_override_reason', '!=', False)]"
                    groups="electrical_store_base.group_electrical_manager" />
            </filter>

        </field>
    </record>

</odoo>

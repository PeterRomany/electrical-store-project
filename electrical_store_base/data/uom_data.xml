<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             COUNT UNITS — Category: Unit(s)
             Base unit: uom.product_uom_unit (1 Unit = 1 Piece)

             Odoo factor formula:
             factor = 1 / qty_in_base_units
             Example: 1 Box = 120 Pieces → factor = 1/120 = 0.008333
             ================================================================ -->

        <!-- Box / كرتونة — 1 Box = 120 Pieces -->
        <record id="uom_box" model="uom.uom">
            <field name="name">Box / كرتونة</field>
            <field name="category_id" ref="uom.product_uom_categ_unit"/>
            <field name="factor">0.008333</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">0.001</field>
            <field name="active">True</field>
        </record>

        <!-- Carton / كرتون — 1 Carton = 48 Pieces -->
        <record id="uom_carton" model="uom.uom">
            <field name="name">Carton / كرتون</field>
            <field name="category_id" ref="uom.product_uom_categ_unit"/>
            <field name="factor">0.020833</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">0.001</field>
            <field name="active">True</field>
        </record>

        <!-- Pack / باكيت — 1 Pack = 12 Pieces -->
        <record id="uom_pack" model="uom.uom">
            <field name="name">Pack / باكيت</field>
            <field name="category_id" ref="uom.product_uom_categ_unit"/>
            <field name="factor">0.083333</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">0.001</field>
            <field name="active">True</field>
        </record>

        <!-- ================================================================
             LENGTH UNITS — Category: Length
             Base unit: Meter (uom.product_uom_meter)

             factor = 1 / qty_in_base_units
             Example: 1 Roll = 100 Meters → factor = 1/100 = 0.01
             ================================================================ -->

        <!-- Roll / لفة — 1 Roll = 100 Meters -->
        <record id="uom_roll" model="uom.uom">
            <field name="name">Roll / لفة</field>
            <field name="category_id" ref="uom.uom_categ_length"/>
            <field name="factor">0.010000</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">0.001</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ================================================================
             Module Category
             ================================================================ -->

        <record id="module_category_electrical_store" model="ir.module.category">
            <field name="name">Electrical Store / محل كهرباء</field>
            <field name="description">
                Access rights for the Electrical Supplies Store ERP system.
            </field>
            <field name="sequence">100</field>
        </record>

        <!-- ================================================================
             Group: Cashier / كاشير
             ================================================================ -->

        <record id="group_electrical_cashier" model="res.groups">
            <field name="name">Cashier / كاشير</field>
            <field name="category_id" ref="module_category_electrical_store"/>
            <field name="implied_ids" eval="[
                (4, ref('point_of_sale.group_pos_user')),
                (4, ref('base.group_user')),
            ]"/>
            <field name="comment">
                Can operate POS, view products, view customer info.
                Cannot modify products, prices, or inventory.
            </field>
        </record>

        <!-- ================================================================
             Group: Store Keeper / أمين المخزن
             ================================================================ -->

        <record id="group_electrical_storekeeper" model="res.groups">
            <field name="name">Store Keeper / أمين المخزن</field>
            <field name="category_id" ref="module_category_electrical_store"/>
            <field name="implied_ids" eval="[
                (4, ref('stock.group_stock_user')),
                (4, ref('base.group_user')),
            ]"/>
            <field name="comment">
                Can manage inventory, receive purchase orders,
                record damage and scrap, update product info.
            </field>
        </record>

        <!-- ================================================================
             Group: Accountant / محاسب
             ================================================================ -->

        <record id="group_electrical_accountant" model="res.groups">
            <field name="name">Accountant / محاسب</field>
            <field name="category_id" ref="module_category_electrical_store"/>
            <field name="implied_ids" eval="[
                (4, ref('account.group_account_user')),
                (4, ref('base.group_user')),
            ]"/>
            <field name="comment">
                Can manage customer accounts, credit limits,
                generate statements, view financial reports.
            </field>
        </record>

        <!-- ================================================================
             Group: Manager / مدير
             ================================================================ -->

        <record id="group_electrical_manager" model="res.groups">
            <field name="name">Manager / مدير</field>
            <field name="category_id" ref="module_category_electrical_store"/>
            <field name="implied_ids" eval="[
                (4, ref('electrical_store_base.group_electrical_cashier')),
                (4, ref('electrical_store_base.group_electrical_storekeeper')),
                (4, ref('electrical_store_base.group_electrical_accountant')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('point_of_sale.group_pos_manager')),
                (4, ref('account.group_account_manager')),
            ]"/>
            <field name="comment">
                Full access to all store operations including
                overriding credit blocks and approving transactions.
            </field>
        </record>

    </data>
</odoo>
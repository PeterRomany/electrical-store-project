<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Extend Product Form — Add Electrical Info Tab
         ================================================================ -->

    <record id="view_product_template_form_electrical" model="ir.ui.view">
        <field name="name">product.template.form.electrical</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Add Electrical Info notebook page -->
            <notebook position="inside">
                <page string="Electrical Info / معلومات كهربائية"
                      name="electrical_info">

                    <group>

                        <!-- Left column: Specifications -->
                        <group string="Specifications / المواصفات">
                            <field name="brand_id"
                                   options="{'no_create': False,
                                             'no_create_edit': False}"/>
                            <field name="watt"/>
                            <field name="voltage"/>
                            <field name="warranty_months"/>
                        </group>

                        <!-- Right column: Store Info -->
                        <group string="Store Info / معلومات المحل">
                            <field name="shelf_location"/>
                            <field name="product_alias"/>
                        </group>

                    </group>

                    <!-- Arabic Keywords — full width -->
                    <group string="Arabic Search Keywords / كلمات البحث العربية">
                        <field name="arabic_keywords"
                               nolabel="1"
                               placeholder="أدخل الكلمات العربية للبحث مفصولة بمسافات — مثال: لمبة ليد توفير طاقة"/>
                    </group>

                </page>
            </notebook>

        </field>
    </record>

    <!-- ================================================================
         Extend Product List — Add Brand + Shelf columns
         ================================================================ -->

    <record id="view_product_template_list_electrical" model="ir.ui.view">
        <field name="name">product.template.list.electrical</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="after">
                <field name="brand_id"
                       string="Brand / الماركة"
                       optional="show"/>
                <field name="watt"
                       string="Watt / واط"
                       optional="hide"/>
                <field name="voltage"
                       string="Voltage / جهد"
                       optional="hide"/>
                <field name="shelf_location"
                       string="Shelf / الرف"
                       optional="show"/>
                <field name="product_alias"
                       string="Alias / الاسم الشائع"
                       optional="hide"/>
            </field>

        </field>
    </record>

    <!-- ================================================================
         Extend Product Search — Add electrical filters
         ================================================================ -->

    <record id="view_product_template_search_electrical" model="ir.ui.view">
        <field name="name">product.template.search.electrical</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <!-- Extra search fields -->
            <field name="name" position="after">
                <field name="brand_id"
                       string="Brand / الماركة"/>
                <field name="product_alias"
                       string="Alias / الاسم الشائع"
                       filter_domain="[('product_alias', 'ilike', self)]"/>
                <field name="arabic_keywords"
                       string="Arabic Keywords / كلمات عربية"
                       filter_domain="[('arabic_keywords', 'ilike', self)]"/>
                <field name="shelf_location"
                       string="Shelf / الرف"
                       filter_domain="[('shelf_location', 'ilike', self)]"/>
            </field>

            <!-- Extra filters -->
            <filter name="filter_available" position="after">
                <separator/>
                <filter name="filter_has_brand"
                        string="Has Brand / له ماركة"
                        domain="[('brand_id', '!=', False)]"/>
                <filter name="filter_no_brand"
                        string="No Brand / بدون ماركة"
                        domain="[('brand_id', '=', False)]"/>
                <filter name="filter_has_warranty"
                        string="Has Warranty / له ضمان"
                        domain="[('warranty_months', '>', 0)]"/>
            </filter>

            <!-- Group By -->
            <group expand="0" string="Group By" position="inside">
                <filter name="group_by_brand"
                        string="Brand / الماركة"
                        context="{'group_by': 'brand_id'}"/>
                <filter name="group_by_categ"
                        string="Category / الفئة"
                        context="{'group_by': 'categ_id'}"/>
                <filter name="group_by_shelf"
                        string="Shelf Location / الرف"
                        context="{'group_by': 'shelf_location'}"/>
            </group>

        </field>
    </record>

</odoo>
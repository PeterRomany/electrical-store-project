<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Extend POS Configuration Form
         Add Electrical Store settings tab
         ================================================================ -->

    <record id="view_pos_config_form_electrical" model="ir.ui.view">
        <field name="name">pos.config.form.electrical</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <notebook>
                <page string="إعدادات محل الكهرباء"
                      name="electrical_store">

                    <!-- Search Settings -->
                    <group string="إعدادات البحث">
                        <group>
                            <field name="iface_arabic_search"/>
                        </group>
                        <group>
                            <div class="text-muted" style="font-size:12px;">
                                يتيح للكاشير البحث باسم المنتج أو الاسم الشائع أو الكلمات العربية.
                            </div>
                        </group>
                    </group>

                    <separator/>

                    <!-- Display Settings -->
                    <group string="إعدادات العرض">
                        <group>
                            <field name="iface_show_stock"/>
                            <field name="iface_show_electrical_info"/>
                            <field name="iface_show_customer_balance"/>
                        </group>
                        <group>
                            <div class="text-muted" style="font-size:12px;">
                                اختر المعلومات التي تظهر للكاشير في شاشة البيع.
                            </div>
                        </group>
                    </group>

                    <separator/>

                    <!-- Sales Settings -->
                    <group string="إعدادات البيع">
                        <group>
                            <field name="iface_packaging_selector"/>
                            <field name="iface_credit_warning"/>
                        </group>
                        <group>
                            <div class="text-muted" style="font-size:12px;">
                                اختيار التعبئة يتيح البيع بالقطعة أو الكرتونة أو المتر أو اللفة.
                                يظهر تنبيه عند اقتراب العميل من الحد الائتماني.
                            </div>
                        </group>
                    </group>

                    <separator/>

                    <!-- Layout Settings -->
                    <group string="اتجاه الشاشة">
                        <group>
                            <field name="iface_rtl"/>
                        </group>
                        <group>
                            <div class="text-muted" style="font-size:12px;">
                                يجعل اتجاه الشاشة من اليمين إلى اليسار.
                            </div>
                        </group>
                    </group>

                </page>
                </notebook>
            </xpath>

        </field>
    </record>

</odoo>
